FROM openclaw:local

USER root

# Allow the node user to sudo without a password
RUN apt-get update && \
    apt-get install -y --no-install-recommends sudo && \
    echo "node ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/node && \
    chmod 0440 /etc/sudoers.d/node && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install pre-baked packages + browser stack for VNC viewing
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      chromium \
      curl \
      ffmpeg \
      fonts-liberation \
      fonts-noto-color-emoji \
      novnc \
      poppler-utils \
      websockify \
      x11vnc \
      xvfb \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && apt-get install -y --no-install-recommends gh && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install uv (Python package manager — enables uvx awesome-cheap-flights)
RUN curl -fsSL https://astral.sh/uv/install.sh | sh && \
    cp /root/.local/bin/uv /usr/local/bin/uv && \
    cp /root/.local/bin/uvx /usr/local/bin/uvx && \
    rm -rf /root/.local/bin/uv /root/.local/bin/uvx

# Install Python + lunar-python (Chinese lunar calendar library)
RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    uv pip install --system --break-system-packages lunar-python

# Install Rust toolchain (installed to /usr/local so all users can access it)
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
ENV PATH="/usr/local/cargo/bin:${PATH}"
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal

# Install bird (npm package, no Linux binary)
RUN npm install -g @steipete/bird

# Install summarize (web/video/audio content summarizer)
RUN npm install -g @steipete/summarize

# Install liteparse (document parsing)
RUN npm install -g @llamaindex/liteparse

# Install gogcli (binary is named "gog" in the archive)
RUN curl -fsSL https://github.com/steipete/gogcli/releases/download/v0.12.0/gogcli_0.12.0_linux_amd64.tar.gz \
      | tar -xz -C /usr/local/bin gog

# Install goplaces
RUN curl -fsSL https://github.com/steipete/goplaces/releases/download/v0.3.0/goplaces_0.3.0_linux_amd64.tar.gz \
      | tar -xz -C /usr/local/bin goplaces

# Install Claude Code
RUN curl -fsSL https://claude.ai/install.sh | bash && \
    cp /root/.local/bin/claude /usr/local/bin/claude

# Entrypoint wrapper: starts Xvfb + VNC + noVNC, then execs the gateway
COPY scripts/gateway-vnc-entrypoint.sh /usr/local/bin/gateway-vnc-entrypoint
RUN chmod +x /usr/local/bin/gateway-vnc-entrypoint

USER node
